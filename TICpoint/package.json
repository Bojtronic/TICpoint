{
  "name": "ticpoint",
  "version": "0.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "ng": "ng",
    "build": "ng build --configuration production",
    "start": "http-server dist/TICpoint/browser -p $PORT -c-1 --spa -i index.html --no-dir-listing",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "dev:ssr": "ng run TICpoint:serve-ssr",
    "build:ssr": "ng build --configuration production && ng run TICpoint:server:production",
    "serve:ssr": "node dist/TICpoint/server/main.js"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cli": "^20.1.3",
    "http-server": "^14.1.1",
    "@angular/cdk": "^20.1.4",
    "@angular/common": "^20.1.0",
    "@angular/compiler": "^20.1.0",
    "@angular/core": "^20.1.0",
    "@angular/forms": "^20.1.0",
    "@angular/material": "^20.1.4",
    "@angular/platform-browser": "^20.1.0",
    "@angular/platform-server": "^20.1.0",
    "@angular/router": "^20.1.0",
    "@angular/ssr": "^20.1.3",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.1.3",
    "@angular/cli": "^20.1.3",
    "@angular/compiler-cli": "^20.1.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2"
  }
}